<mxfile><diagram name="Account flow"><mxGraphModel dx="1200" dy="800" grid="1" pageWidth="1100" pageHeight="950"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;STEP 1 - Build blocks in UCSF_GL (source of truth)&lt;/b&gt;" style="rounded=0;verticalAlign=top;align=left;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1000" height="140" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;STEP 2 - Maintain: request / validate / approve&lt;/b&gt;" style="rounded=0;verticalAlign=top;align=left;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="1000" height="140" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;STEP 3 - Publish: subscriptions push Oracle Account to other apps&lt;/b&gt;" style="rounded=0;verticalAlign=top;align=left;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="1000" height="140" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;STEP 4 - Same 4 blocks rebuilt in each target app&lt;/b&gt;" style="rounded=0;verticalAlign=top;align=left;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="1000" height="140" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;STEP 5 - Outputs (extracts) and PeopleSoft legacy side&lt;/b&gt;" style="rounded=0;verticalAlign=top;align=left;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="740" width="1000" height="140" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Node Type&lt;/b&gt;&lt;br&gt;Account UCSF Ledger US&lt;br&gt;Class: Normal | Bound&lt;br&gt;(Dimension: Natural Account Segment)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;stro